# Production Environment Variables for Goblin Assistant Backend
# Copy this file to your deployment environment or set these as environment variables

# ========================================
# APPLICATION CONFIGURATION
# ========================================
# Debug mode (set to false in production)
DEBUG=false

# Environment name
ENVIRONMENT=production

# Release version for Sentry
RELEASE_VERSION=goblin-assistant@1.0.0

# ========================================
# SERVER CONFIGURATION
# ========================================
# Port for the application (matches Dockerfile)
PORT=8001

# Allowed origins for CORS (replace with your actual domains)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL database URL (replace with your actual database)
DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# ========================================
# REDIS CONFIGURATION
# ========================================
# Redis URL for caching (replace with your actual Redis instance)
REDIS_URL=redis://username:password@hostname:6379/0

# ========================================
# SECRETS MANAGEMENT
# ========================================
# Secrets backend (vault, bitwarden, etc.)
SECRETS_BACKEND=vault

# Vault configuration (if using Vault)
VAULT_URL=https://your-vault-server:8200
VAULT_MOUNT_POINT=secret
VAULT_TOKEN=your-vault-token-here

# Alternative: AppRole authentication
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id

# ========================================
# SECURITY CONFIGURATION
# ========================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ========================================
# EXTERNAL SERVICES
# ========================================
# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Provider API Keys (set as needed)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_AI_API_KEY=your_google_ai_key

# ========================================
# MONITORING & LOGGING
# ========================================
# Datadog configuration
DD_SERVICE=goblin-assistant
DD_ENV=production
DD_VERSION=1.0.0

# Log level
LOG_LEVEL=INFO

# ========================================
# OPTIONAL SERVICES
# ========================================
# MCP servers (if using)
MCP_SERVERS=localhost:8765

# Chroma vector database
CHROMA_URL=http://localhost:8000

# Cost tracking
COST_TRACKING_ENABLED=true
COST_DB_URL=postgresql+asyncpg://username:password@hostname:5432/costs_db

# Sandbox configuration
VITE_FEATURE_SANDBOX=false
SANDBOX_IMAGE=your-sandbox-image:latest

# ========================================
# FLY.IO SPECIFIC
# ========================================
# Fly.io app name
FLY_APP_NAME=goblin-assistant

# Fly.io region
FLY_REGION=sfo

# Health check configuration
HEALTH_CHECK_URL=http://localhost:8001/health

# ========================================
# SECURITY WARNINGS
# ========================================
# IMPORTANT: Never commit this file with real credentials to version control
# Use your deployment platform's secret management system instead
#
# For Fly.io, set these as secrets:
# fly secrets set DEBUG=false ENVIRONMENT=production RELEASE_VERSION=1.0.0
# fly secrets set DATABASE_URL=your_database_url REDIS_URL=your_redis_url
# fly secrets set VAULT_URL=your_vault_url VAULT_TOKEN=your_vault_token
# fly secrets set NEXT_PUBLIC_SUPABASE_URL=your_supabase_url NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_key
# fly secrets set SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# fly secrets set OPENAI_API_KEY=your_openai_key ANTHROPIC_API_KEY=your_anthropic_key
